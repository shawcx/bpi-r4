From f513bf5c684092e98e43597c9a53a26445d4c243 Mon Sep 17 00:00:00 2001
From: Matthew Shaw <mshaw.cx@gmail.com>
Date: Fri, 23 Oct 2026 13:42:29 -0400
Subject: [PATCH] arm64: dts: mt7988a: add the EIP-197 crypto engine

The MT7988 has the same Inside Secure EIP-197 as the MT7987, whose node
in mt7987a.dtsi gives the address and interrupts. This drops its MediaTek
SDK extras (security-ip-197-srv, eth) for the mainline safexcel driver,
which loads linux-firmware's inside-secure/eip197_minifw.

Untested on hardware.
---
 arch/arm64/boot/dts/mediatek/mt7988a.dtsi | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt7988a.dtsi b/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
index 1abf874112..1523aa8eda 100644
--- a/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
+++ b/arch/arm64/boot/dts/mediatek/mt7988a.dtsi
@@ -1069,6 +1069,16 @@ eth_sram: sram@15400000 {
 			#size-cells = <1>;
 			ranges = <0 0x15400000 0 0x200000>;
 		};
+
+		crypto: crypto@15600000 {
+			compatible = "inside-secure,safexcel-eip197b";
+			reg = <0 0x15600000 0 0x180000>;
+			interrupts = <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 216 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 217 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "ring0", "ring1", "ring2", "ring3";
+		};
 	};
 
 	thermal-zones {
-- 
2.43.0

