# The end of nftables.conf's input and forward chains: what they haven't
# accepted is logged (at most 10 a minute, prefix NF-REJECTED) and refused
# with a reject rather than dropped in silence. Broadcasts and multicasts,
# mostly discovery chatter, are dropped without a log: no one is waiting
# for a reject.
table inet filter {
	chain input {
		goto rejectlog
	}
	chain forward {
		goto rejectlog
	}
	chain rejectlog {
		meta pkttype { broadcast, multicast } drop
		limit rate 10/minute counter log prefix "NF-REJECTED: " level debug
		reject
	}
}
