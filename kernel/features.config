# Kernel features our images add to frank-w's mt7988a_bpi-r4_defconfig
# (Kconfig KERNEL_FRAGMENTS). Modules, loaded on demand.

# WireGuard VPN (wireguard-tools in the image: wg, wg-quick)
CONFIG_WIREGUARD=m
# exFAT, the filesystem of SD cards and USB drives over 32 GB (exfatprogs
# in the image: mkfs.exfat, fsck.exfat)
CONFIG_EXFAT_FS=m
# BBR congestion control and the fq qdisc it paces with; opt in with
# net.ipv4.tcp_congestion_control=bbr and net.core.default_qdisc=fq
CONFIG_TCP_CONG_BBR=m
CONFIG_NET_SCH_FQ=m
# USB 4G/5G modems in MBIM mode (qmi_wwan, option and the PCIe MHI/T7xx
# modem drivers are in the defconfig)
CONFIG_USB_NET_CDC_MBIM=m
# USB serial adapters: consoles, GPS receivers that aren't CDC-ACM
CONFIG_USB_SERIAL_FTDI_SIO=m
CONFIG_USB_SERIAL_CP210X=m
CONFIG_USB_SERIAL_CH341=m
CONFIG_USB_SERIAL_PL2303=m
# iPhone USB tethering (usbmuxd in the image pairs the phone; Android's
# RNDIS, NCM and ECM tethering drivers are in the defconfig)
CONFIG_USB_IPHETH=m
# USB Attached SCSI: USB 3 SSDs and enclosures
CONFIG_USB_UAS=m
# PPS from a serial line's DCD or a GPIO, for a chrony PPS refclock
CONFIG_PPS_CLIENT_LDISC=m
CONFIG_PPS_CLIENT_GPIO=m
# The EIP-197 crypto engine (AES for IPsec and dm-crypt; linux-firmware's
# inside-secure minifw in the image). MT7988's device tree has no node for
# it: kernel/patches-eip197 adds one, untested on hardware so far
CONFIG_CRYPTO_DEV_SAFEXCEL=m
# Device mapper, dm-crypt with XTS (LUKS's default) and software RAID, for the
# cryptsetup, lvm2 and mdadm package options; AF_ALG for cryptsetup benchmark
CONFIG_MD=y
CONFIG_BLK_DEV_DM=m
CONFIG_DM_CRYPT=m
CONFIG_DM_SNAPSHOT=m
CONFIG_DM_THIN_PROVISIONING=m
CONFIG_BLK_DEV_MD=m
CONFIG_MD_RAID0=m
CONFIG_MD_RAID1=m
CONFIG_MD_RAID10=m
CONFIG_MD_RAID456=m
CONFIG_CRYPTO_XTS=m
CONFIG_CRYPTO_USER_API_SKCIPHER=m
# Btrfs, for the btrfs-progs package option
CONFIG_BTRFS_FS=m
# zram: compressed swap in RAM (the systemd-zram-generator package option),
# with the zstd and lz4 compressors
CONFIG_ZRAM=m
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
# KVM, for the Virtual machines package options (the CPUs start at EL2), with
# vhost-net and macvtap for guest networking
CONFIG_VIRTUALIZATION=y
CONFIG_KVM=y
CONFIG_VHOST_NET=m
CONFIG_MACVTAP=m
