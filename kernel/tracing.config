# BPF tracing (Kconfig KERNEL_TRACING): kprobes and uprobes for bpftrace and
# the bcc tools, BTF type information (needs debug info, and pahole on the
# build host), and the kernel headers in /sys/kernel/kheaders.tar.xz for bcc
CONFIG_KPROBES=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBE_EVENTS=y
CONFIG_DEBUG_INFO_DWARF_TOOLCHAIN_DEFAULT=y
CONFIG_DEBUG_INFO_BTF=y
CONFIG_IKHEADERS=m
