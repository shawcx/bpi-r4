# Image options for build.sh: make menuconfig / make <name>_defconfig,
# see the Makefile. The defaults build today's "endpoint" image for the
# BPI-R4 Pro 8X; configs/*_defconfig hold the other boards.

mainmenu "BPI-R4 image configuration"

choice
	prompt "Board"
	default BOARD_R4PRO_8X

config BOARD_R4PRO_8X
	bool "BPI-R4 Pro 8X"
	help
	  BPI-R4 Pro 8X: MxL862xx switch (lan1-4, lan6 combo), MT7988
	  switch (lan5), 10G combo WAN.

config BOARD_R4PRO_4E
	bool "BPI-R4 Pro 4E"
	help
	  BPI-R4 Pro 4E: shares the R4 Pro u-boot and image; its u-boot
	  release defaults to the 2026.07 CI build, the first that knows
	  isr4pro4e=1 (its FIT config). Needs kernel 7.2.

config BOARD_R4
	bool "BPI-R4 (2x SFP)"
	help
	  The standard BPI-R4 with two SFP cages (not the 2g5 variant).

endchoice

config BOARD
	string
	default "r4pro" if BOARD_R4PRO_8X
	default "r4pro4e" if BOARD_R4PRO_4E
	default "r4" if BOARD_R4

choice
	prompt "Boot device"
	default DEVICE_SDMMC

config DEVICE_SDMMC
	bool "SD card"

config DEVICE_EMMC
	bool "eMMC"
	help
	  Also writes <image>_bl2.img, the bl2 for the eMMC boot0 hardware
	  partition (the image's own bl2 partition is empty on eMMC).

endchoice

config DEVICE
	string
	default "emmc" if DEVICE_EMMC
	default "sdmmc"

choice
	prompt "RAM"
	default RAM_8G if BOARD_R4PRO_8X
	default RAM_4G

config RAM_4G
	bool "4 GB"

config RAM_8G
	bool "8 GB"
	help
	  Writes u-boot's 8GB bl2 and fip into the image.

endchoice

config RAM
	int
	default 8 if RAM_8G
	default 4

choice
	prompt "Kernel"
	default KERNEL_7_2 if BOARD_R4PRO_4E
	default KERNEL_6_18
	help
	  frank-w's BPI-Router-Linux CI builds of this branch.

config KERNEL_6_18
	bool "6.18 (LTS)"
	depends on !BOARD_R4PRO_4E
	help
	  Long-term branch with point releases. Has no 4E device tree
	  overlays.

config KERNEL_7_2
	bool "7.2"
	help
	  Newest branch: adds the 8X LAN/WAN and 4E WAN PHY/SFP overlays and
	  per-slot M.2 overlays. Names the gmacs eth0-2 (WAN on eth1).

endchoice

config KERNEL
	string
	default "7.2" if KERNEL_7_2
	default "6.18"

choice
	prompt "Kernel build"
	default KERNEL_SOURCE

config KERNEL_CI
	bool "frank-w's CI build"
	help
	  The branch's latest CI build from frank-w/BPI-Router-Linux
	  releases, or the one pinned under Releases. His defconfig has no
	  WireGuard or exFAT, nor the rest of kernel/features.config.

config KERNEL_SOURCE
	bool "Built from source"
	help
	  scripts/kernel builds frank-w's tree (or a fork, a local tree,
	  patches, config changes; see Kernel source) the way his CI does:
	  the bpi-r4.itb FIT image with the board device trees and overlays,
	  and the modules. Cross-compiled on x86_64 (gcc-aarch64-linux-gnu),
	  native on arm64; incremental, in .cache/kernel. make kernel builds
	  just the kernel, make kernel-menuconfig configures it. The default,
	  for kernel/features.config (WireGuard, exFAT, ...).

endchoice

menu "Kernel source"
	depends on KERNEL_SOURCE

config KERNEL_GIT
	string "Git repository"
	default "https://github.com/frank-w/BPI-Router-Linux.git"
	help
	  Fetched shallowly at the ref below; a fork or a local repository
	  (path) works too.

config KERNEL_REF
	string "Branch, tag or commit"
	help
	  Empty: the kernel branch's <branch>-main, e.g. 7.2-main.

config KERNEL_PATCHES
	string "Patch directory"
	help
	  *.patch files (git format-patch) applied in name order on top of
	  the ref with git am; relative to this repo, e.g. kernel/patches.

config KERNEL_TREE
	string "Local tree (instead of git)"
	help
	  A frank-w kernel checkout built as it is, uncommitted changes
	  included (out of tree, so it must not have an in-tree build);
	  the repository, ref and patches above are then unused.

config KERNEL_DEFCONFIG
	string "Base kernel config"
	help
	  Empty: the tree's mt7988a_bpi-r4_defconfig. Otherwise a defconfig
	  file relative to this repo, e.g. from make kernel-savedefconfig
	  OUT=kernel/my_defconfig.

config KERNEL_FRAGMENTS
	string "Config fragments"
	default "kernel/features.config kernel/r4-only.config"
	help
	  Space-separated files of CONFIG_ lines (as make kernel-menuconfig
	  FRAGMENT=kernel/x.config writes) merged on top of the base config,
	  relative to this repo. A value the kernel's Kconfig drops (an
	  unmet dependency, a misspelt symbol) stops the build.
	  kernel/features.config adds WireGuard, exFAT, BBR, USB modem,
	  serial and storage drivers, PPS clients, zram, KVM, the EIP-197
	  crypto driver and the schedutil cpufreq governor (the defconfig's
	  userspace one holds the CPUs at 1.5 GHz); kernel/r4-only.config
	  leaves out drivers for hardware the R4 family doesn't have (other
	  MediaTek SoCs' clocks and pin controllers, EFI, VT, PS/2, libata).

config KERNEL_LOCALVERSION
	string "Version suffix"
	default "-custom"
	help
	  Appended to the kernel version, in the image name and uname -r
	  (CI builds have -main): 7.2.0-custom, 7.2.0-bpi-r4-custom.

comment "Kernel extras"

config KERNEL_APPARMOR
	bool "AppArmor"
	help
	  kernel/apparmor.config: the AppArmor LSM, on at boot; images get
	  the apparmor package with the distribution's profiles. Docker,
	  Podman, LXC and Incus confine their containers with it. Services
	  that ship profiles run confined too, chrony and gpsd among them:
	  check them on the board.

config KERNEL_TRACING
	bool "BPF tracing"
	help
	  kernel/tracing.config: kprobes, uprobes, BTF and the kernel
	  headers, for bpftrace and the bcc tools (both installed). BTF
	  needs the kernel built with debug info and pahole (dwarves) on the
	  build host: kernel builds are slower and the kernel a few MB
	  bigger. Modules are installed stripped.

# the fragments the extras add to KERNEL_FRAGMENTS
config KERNEL_EXTRA_FRAGMENTS
	string
	default "kernel/apparmor.config kernel/tracing.config" if KERNEL_APPARMOR && KERNEL_TRACING
	default "kernel/apparmor.config" if KERNEL_APPARMOR
	default "kernel/tracing.config" if KERNEL_TRACING

endmenu

choice
	prompt "Distribution"
	default DISTRO_TRIXIE
	help
	  Root filesystem release, bootstrapped with debootstrap and cached
	  as .cache/rootfs/<release>_arm64.tar.gz (build.sh --clean rebuilds
	  it); each image then installs the release's updates.

config DISTRO_TRIXIE
	bool "Debian 13 (trixie)"

config DISTRO_BOOKWORM
	bool "Debian 12 (bookworm)"

config DISTRO_NOBLE
	bool "Ubuntu 24.04 (noble)"

config DISTRO_RESOLUTE
	bool "Ubuntu 26.04 (resolute)"
	help
	  Needs a debootstrap with a resolute script on the build host
	  (Debian's 1.0.142 or Ubuntu's 1.0.142ubuntu2 and newer).

endchoice

config DISTRO
	string
	default "bookworm" if DISTRO_BOOKWORM
	default "noble" if DISTRO_NOBLE
	default "resolute" if DISTRO_RESOLUTE
	default "trixie"

config DEBIAN_MIRROR
	string "Debian mirror"
	default "http://deb.debian.org/debian"
	help
	  The archive for the bootstrap and the image's sources.list
	  (security updates come from security.debian.org regardless). A
	  caching proxy speeds up rebuilds, e.g. apt-cacher-ng's
	  http://<host>:3142/deb.debian.org/debian.

config UBUNTU_MIRROR
	string "Ubuntu mirror"
	default "http://ports.ubuntu.com/ubuntu-ports"
	help
	  The archive for the bootstrap and the image's sources.list,
	  including security updates: a ports mirror, as arm64 isn't on the
	  main Ubuntu archive.

# the one the distribution uses; derived rather than a default of a
# visible option, which a saved .config would pin
config MIRROR
	string
	default UBUNTU_MIRROR if DISTRO_NOBLE || DISTRO_RESOLUTE
	default DEBIAN_MIRROR

menu "Releases"

config UBOOT_RELEASE
	string "u-boot release"
	help
	  A frank-w/u-boot release tag for the base image, bl2 and fip.
	  Empty takes the board's default: the latest release, except on
	  the 4E, which needs 2026.07 or newer and gets the 2026.07 CI build
	  (build.sh).

config KERNEL_RELEASE
	string "Kernel release"
	depends on KERNEL_CI
	help
	  A frank-w/BPI-Router-Linux release tag of the chosen kernel
	  branch (CI-BUILD-<branch>-main-<version>-<date>); empty takes the
	  branch's latest CI build.

config DT_OVERLAYS
	string "Extra device tree overlays"
	help
	  Space-separated FIT overlay names for u-boot's addconf, after the
	  board's (the 8X/4E port overlays and the M.2 slots' ov-pro-cn14
	  and ov-pro-cn15). Ones the kernel's FIT doesn't have are dropped.

endmenu

menu "Network"

choice
	prompt "R4 Pro combo/WAN ports"
	depends on BOARD_R4PRO_8X || BOARD_R4PRO_4E
	default PORTS_PHY if BOARD_R4PRO_4E
	default PORTS_SFP
	help
	  8X: the 10G LAN (lan6) and WAN combo ports. 4E: the WAN, on SFP2
	  or the 2.5G RJ45. Selected by device tree overlay on 7.2; 6.18 has
	  no 4E overlays and switches the 8X ports on SFP module presence.

config PORTS_SFP
	bool "SFP"

config PORTS_PHY
	bool "RJ45 (PHY)"

endchoice

config PORTS
	string
	default "phy" if PORTS_PHY
	default "sfp"

choice
	prompt "Role"
	default ROLE_ROUTER

config ROLE_ROUTER
	bool "Router"
	help
	  The WAN takes a DHCP lease; the LAN ports are bridged as lanbr0
	  with a static address and optionally a DHCP server, and IPv4 is
	  forwarded between them (NAT and firewall with FIREWALL).

config ROLE_SWITCH
	bool "Switch"
	help
	  Every port, WAN included, in one bridge (lanbr0) that takes a DHCP
	  lease: the board passes traffic like a switch and is reachable at
	  that address. No DHCP server, forwarding, NAT or nftables.

endchoice

config ROLE
	string
	default "switch" if ROLE_SWITCH
	default "router"

config LAN_ADDRESS
	string "LAN address"
	depends on ROLE_ROUTER
	default "192.168.1.1/24"
	help
	  lanbr0's address and prefix (/8 to /30, at most /24 with the DHCP
	  server).

config DHCP_SERVER
	bool "DHCP server on the LAN"
	depends on ROLE_ROUTER
	default y
	help
	  networkd's DHCP server on lanbr0, leasing host numbers 101-250 of
	  the LAN subnet and passing on the WAN's DNS servers.

config FIREWALL
	bool "NAT and firewall (nftables)"
	depends on ROLE_ROUTER
	default y
	help
	  Masquerades the LAN to the WAN and drops what isn't LAN traffic,
	  replies, ping, DHCP or (with SSH_FROM_WAN) SSH. Without it the
	  board still forwards, unNATed and unfiltered.

config SSH_FROM_WAN
	bool "Allow SSH from the WAN side"
	depends on FIREWALL
	default y
	help
	  Root SSH takes keys only.

choice
	prompt "Cellular modem"
	default MODEM_NONE
	help
	  A 4G/5G modem, e.g. in the R4 Pro's M.2 key-B slot. The kernel
	  drivers (qmi_wwan, cdc_mbim, option, MHI, T7xx) are there either
	  way; this is the userspace. The modem's interface counts as WAN
	  to the firewall (masqueraded, input dropped). A modem switched to
	  ECM mode is a USB uplink instead (USB_WAN).

config MODEM_NONE
	bool "None"

config MODEM_MM
	bool "ModemManager"
	help
	  ModemManager with qmicli and mbimcli, for QMI and MBIM modems
	  (a Quectel RM520N in its default QMI mode). modem-connect.service
	  enables the modem and keeps a data connection up with the APN;
	  ModemManager's connection dispatcher puts the addresses, a default
	  route with the metric and the DNS servers on the wwan interface,
	  which networkd leaves alone. Without a SIM it waits.

endchoice

config MODEM
	string
	default "mm" if MODEM_MM
	default "none"

config MODEM_APN
	string "APN"
	depends on MODEM_MM
	help
	  Empty: the network's default (most LTE/5G networks). A PIN-locked
	  SIM has to be unlocked by hand (mmcli -i <sim> --pin=<PIN>).

config USB_WAN
	bool "Phones and ECM modems on USB as backup uplinks"
	default y
	help
	  networkd takes a DHCP lease, with the backup route metric, on USB
	  network interfaces from phones and modems: Android tethering
	  (RNDIS, NCM, ECM), iPhone tethering (ipheth; usbmuxd does the
	  "Trust this computer" pairing) and modems switched to ECM mode
	  (Quectel: AT+QCFG="usbnet",1, APN set in the modem). Any
	  cdc_ether or cdc_ncm device counts, USB Ethernet adapters in
	  those modes too. They count as WAN to the firewall.

config BACKUP_METRIC
	int "Backup route metric"
	depends on MODEM_MM || USB_WAN
	range 1 65535
	default 2048
	help
	  The default route metric of the cellular modem and USB uplinks.
	  Above the WAN's (networkd's DHCP default, 1024) they're backups,
	  used when the WAN's route goes (link or lease lost); below, the
	  preferred route. A WAN that stays up while the ISP fails upstream
	  keeps its route: that needs a health check.

endmenu

menu "Wi-Fi"

choice
	prompt "Wi-Fi mode"
	default WIFI_MONITOR

config WIFI_MONITOR
	bool "Monitor-only MT7915/MT7916"
	help
	  mt7915e cards (MT7915/MT7916) in monitor mode only: no hostapd,
	  no networkd config on wlan*, no BE14 (mt7996) firmware and its
	  driver blacklisted. The build checks the mt7915/mt7916 firmware
	  is in the image.

config WIFI_AP
	bool "Access point"
	help
	  hostapd access points on the Wi-Fi cards (MT7915/MT7916, BE14),
	  one per band. At boot, wifi-ap (overlays/wifi-ap) gives each band
	  a radio that can run it and makes hostapd's config from the
	  card's capabilities. The settings go in the board's
	  /etc/default/wifi-ap, where they can be changed. Needs REGDOM.
	  Wi-Fi 6 at most: the distributions' hostapd 2.10 has no Wi-Fi 7.

config WIFI_OFF
	bool "Off"
	help
	  No hostapd and no wlan networkd config; mt7915e and mt7996e are
	  blacklisted.

endchoice

config WIFI
	string
	default "ap" if WIFI_AP
	default "off" if WIFI_OFF
	default "monitor"

menu "Access point"
	depends on WIFI_AP

config WIFI_SSID
	string "Network name (SSID)"
	help
	  Up to 32 bytes, the same on every band. Empty uses the hostname.

config WIFI_PASSPHRASE
	string "Passphrase"
	help
	  8 to 63 characters. Kept in plain text in .config,
	  out/<image>.config and the board's /etc/default/wifi-ap (readable
	  by root only). The WIFI_PASSPHRASE environment variable overrides
	  it and keeps it out of the config files.

config WIFI_WPA3_ONLY
	bool "WPA3 only"
	help
	  WPA3 (SAE) only on 2.4 and 5 GHz too, which clients from before
	  about 2019 can't join. Without it, those bands take WPA2 and WPA3
	  (transition mode). 6 GHz is always WPA3 only.

comment "Bands: each needs a radio that can run it"

config WIFI_5G
	bool "5 GHz"
	default y
	help
	  80 MHz wide. Bands get radios in the order 5, 6, 2.4 GHz: a card
	  that runs one band at a time, like the MT7915E, serves the first
	  of them it can, so a single MT7915E gives 5 GHz only; two give 5
	  and 2.4 GHz. Bands no radio is left for are skipped.

config WIFI_CHANNEL_5G
	int "5 GHz channel (0: automatic)"
	depends on WIFI_5G
	default 36
	help
	  36-64, 100-144 or 149-177, in steps of 4; the 80 MHz block is the
	  one the channel is in. 52-144 need radar detection: the access
	  point listens for a minute (ten on 120-128) before it starts.
	  Automatic leaves those out.

config WIFI_6G
	bool "6 GHz"
	default y
	help
	  80 MHz wide, WPA3 only. Needs a card with 6 GHz, such as the BE14.

config WIFI_CHANNEL_6G
	int "6 GHz channel (0: automatic)"
	depends on WIFI_6G
	default 37
	help
	  1-233 in steps of 4. Clients find access points fastest on the
	  preferred scanning channels (5, 21, 37 and every 16th after),
	  which automatic sticks to.

config WIFI_2G4
	bool "2.4 GHz"
	default y
	help
	  20 MHz wide.

config WIFI_CHANNEL_2G4
	int "2.4 GHz channel (0: automatic)"
	depends on WIFI_2G4
	range 0 13
	default 1

choice
	prompt "Wi-Fi clients' network"
	default WIFI_NET_LAN

config WIFI_NET_LAN
	bool "The LAN"
	help
	  The access points are bridged into lanbr0: Wi-Fi clients are on
	  the LAN like wired ones, with the router's DHCP leases, or with
	  the switch role, the upstream network's.

config WIFI_NET_SUBNET
	bool "A subnet of their own"
	depends on ROLE_ROUTER
	help
	  The access points are bridged as wlanbr0, with WIFI_ADDRESS and a
	  DHCP server, and routed (NATed, with the firewall) to the WAN.

endchoice

config WIFI_ADDRESS
	string "Wi-Fi subnet address"
	depends on WIFI_NET_SUBNET
	default "192.168.20.1/24"
	help
	  wlanbr0's address and prefix (/8 to /24), outside the LAN. Its
	  DHCP server leases host numbers 101-250 and passes on the WAN's
	  DNS servers.

config WIFI_GUEST
	bool "Guest network: no LAN access"
	depends on WIFI_NET_SUBNET && FIREWALL
	help
	  Wi-Fi clients reach the WAN only: not the LAN, and not the router
	  except for DHCP and ping (overlays/wifi-guest).

endmenu

config REGDOM
	string "Regulatory domain"
	help
	  cfg80211's ieee80211_regdom (two letters, 00 for world), also
	  hostapd's country_code with the AP, which needs one. Empty leaves
	  the kernel's world domain.

endmenu

menu "Identity"

config HOSTNAME
	string "Hostname"
	default "endpoint"

config ROOT_PASSWORD
	string "Root password (console only)"
	help
	  SSH takes keys only. Empty keeps scripts/mkimage's default; the
	  ROOT_PASSWORD environment variable overrides both. Kept in plain
	  text in .config and out/<image>.config.

config LOCALES
	string "Locales"
	default "en_US.UTF-8"
	help
	  Space-separated locales generated with locale-gen; the first is
	  the system's LANG. SSH clients pass theirs (LANG, LC_*), which
	  must exist to avoid "cannot change locale" warnings. Empty: only
	  C.UTF-8, built into libc.

config AUTHORIZED_KEYS
	string "Root SSH authorized_keys file"
	default "root_authorized_keys"
	help
	  Relative to the repo, or absolute. Password login over SSH is
	  disabled, so without a key here (or without the file) root logs
	  in on the serial console only.

endmenu

menu "Time"

config GPS_TIME
	bool "GPS time (gpsd + chrony refclock)"
	default y
	help
	  Installs gpsd, polling the receiver without clients, and gives
	  chrony its time as a refclock (NTP shared memory segment 0).
	  Without it chrony uses the distribution's NTP pool only.

config GPS_DEVICE
	string "GPS receiver"
	depends on GPS_TIME
	default "/dev/ttyACM0"

config GPS_OFFSET
	string "GPS serial time offset (seconds)"
	depends on GPS_TIME
	default "0.067"
	help
	  How late the receiver's serial time arrives; 0.067 for a u-blox 7
	  on USB at 9600 baud.

endmenu

