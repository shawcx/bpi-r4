config EXTRA_PACKAGES
	string "Extra packages"
	help
	  Space-separated, installed with their recommends, like the options
	  above. Always installed: ssh, chrony, iw, xz-utils,
	  wireguard-tools, exfatprogs, locales and systemd-resolved; gpsd
	  with GPS time, nftables with the firewall (Debian's base system has
	  it anyway), hostapd with the AP, usbmuxd with USB uplinks,
	  ModemManager with the cellular modem.

endmenu

