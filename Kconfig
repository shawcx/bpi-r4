menu "Monitoring"

config PKG_HTOP
	bool "htop: interactive process viewer"

config PKG_BTOP
	bool "btop: resource monitor: CPU, memory, disks, network"

config PKG_GLANCES
	bool "glances: system overview, with a web and API mode"

config PKG_ATOP
	bool "atop: system and process activity, logged over time"

config PKG_NMON
	bool "nmon: performance monitor"

config PKG_IOTOP_C
	bool "iotop-c: per-process disk I/O"

config PKG_SYSSTAT
	bool "sysstat: sar, iostat, mpstat history"

config PKG_LSOF
	bool "lsof: open files and sockets per process"

config PKG_STRACE
